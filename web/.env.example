# 展示模式（正式資料服務的金鑰只能由後端讀取）
DATA_PROVIDER=hybrid
DATABASE_URL="file:./data/moneymoney.db"
FASTAPI_URL=http://localhost:8000

# 成交金額分級（新台幣）
LARGE_ORDER_AMOUNT=1000000
SMALL_ORDER_MAX_AMOUNT=300000
MEDIUM_ORDER_MAX_AMOUNT=1000000

# 準即時更新秒數
QUOTE_REFRESH_SECONDS=10
MARKET_FORCE_REFRESH_SECONDS=10
FUTURES_REFRESH_SECONDS=30
MARKET_SCAN_SECONDS=60
MARKET_REGIME_SECONDS=60

# 正式串接時使用
# FINMIND_API_TOKEN=
