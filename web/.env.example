# 本機開發固定使用 local；Railway 由平台環境變數設定為 railway。
APP_RUNTIME_MODE=local
FASTAPI_URL=http://127.0.0.1:8000

# 本機 Next.js 內建掃描 worker 通常留空；正式 standalone 會由 process-manager 自動設定。
SCANNER_WORKER_URL=

DATABASE_URL=file:./data/moneymoney.db
PRIVATE_SITE_USERNAME=admin
PRIVATE_SITE_PASSWORD=111
PRIVATE_SITE_SESSION_SECRET=replace-with-a-long-random-secret
ADAPTIVE_ELECTRONIC_SCANNER_TOKEN=replace-with-at-least-32-random-characters

# 可選的市場資料設定（只可放伺服器端變數，不使用 NEXT_PUBLIC_ 前綴）
FINMIND_API_TOKEN=
LARGE_ORDER_AMOUNT=1000000
SMALL_ORDER_MAX_AMOUNT=300000
MARKET_FORCE_REFRESH_SECONDS=30
FUTURES_REFRESH_SECONDS=30
MARKET_SCAN_SECONDS=60
