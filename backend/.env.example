APP_ENV=development
APP_RUNTIME_MODE=local
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://moneymoney:moneymoney@localhost:5432/moneymoney
LOCAL_DATABASE_URL=sqlite:///./data/moneymoney-backend.db
# Use the public/external PostgreSQL URL when switching from this computer.
REMOTE_DATABASE_URL=
CORS_ORIGINS=http://localhost:3000
MOCK_DATA_ENABLED=true
REDIS_URL=redis://localhost:6379/0
QUOTE_REFRESH_SECONDS=1
DAY_TRADING_STREAM_SECONDS=2
AI_STOCK_MONITOR_SECONDS=60
# 後端背景選股器會定時呼叫此正式市場掃描 API；留空時停用自動掃描
AI_STOCK_SCANNER_URL=http://localhost:3000/api/ai?refresh=1
AI_STOCK_SCANNER_TIMEOUT_SECONDS=30
AI_STOCK_AUTOMATION_USER_ID=system-ai-stock
ADAPTIVE_ELECTRONIC_ENABLED=true
ADAPTIVE_ELECTRONIC_SCANNER_URL=http://localhost:3000/api/adaptive-electronic/scan
ADAPTIVE_ELECTRONIC_SCANNER_TIMEOUT_SECONDS=90
# PUT 參數與手動重新計算使用；正式環境必須設定不可猜測的值
ADAPTIVE_ELECTRONIC_ADMIN_TOKEN=
ROCKET_RADAR_ENABLED=true
# 留空時會由 ADAPTIVE_ELECTRONIC_SCANNER_URL 自動改用 /api/rocket-radar/scan
ROCKET_RADAR_SCANNER_URL=http://localhost:3000/api/rocket-radar/scan
ROCKET_RADAR_SCAN_INTERVAL_SECONDS=60
ROCKET_RADAR_SCANNER_TIMEOUT_SECONDS=900
LARGE_HOLDER_AUTO_SYNC_ENABLED=true
LARGE_HOLDER_SYNC_INTERVAL_SECONDS=21600
TWSE_TIMEZONE=Asia/Taipei
# 以逗號分隔 YYYY-MM-DD；正式上線請由 TWSE 行事曆同步更新
TWSE_HOLIDAYS=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_TARGET_GROUP_ID=
LINE_NOTIFICATIONS_ENABLED=true
LINE_DAILY_TRADE_MESSAGE_LIMIT=200
LINE_MIN_DAILY_TRADE_MESSAGE_LIMIT=6
# 當沖事件 Gmail 備援通知；請使用 Google「應用程式密碼」，不可填一般登入密碼
GMAIL_NOTIFICATIONS_ENABLED=true
GMAIL_SENDER_EMAIL=
GMAIL_APP_PASSWORD=
GMAIL_RECIPIENT_EMAILS=
GMAIL_SENDER_NAME=Moneymoney AI 當沖機器人
GMAIL_APPS_SCRIPT_URL=
GMAIL_APPS_SCRIPT_SECRET=
# AI選股機器人專用 LINE Messaging API（請勿與當沖憑證混用）
AI_STOCK_LINE_CHANNEL_ACCESS_TOKEN=
AI_STOCK_LINE_CHANNEL_SECRET=
AI_STOCK_LINE_TARGET_GROUP_ID=
AI_STOCK_LINE_NOTIFICATIONS_ENABLED=true
PUBLIC_WEB_URL=
# Fugle 行情金鑰僅放在部署平台的加密環境變數，不可提交真實值
FUGLE_MARKETDATA_API_KEY=
FUGLE_MARKETDATA_BASE_URL=https://api.fugle.tw/marketdata/v1.0
FUGLE_CHIP_FLOW_PAGE_SIZE=500
FUGLE_CHIP_FLOW_MAX_PAGES=100
FUGLE_CHIP_FLOW_INCLUDE_ODD_LOT=false
FUGLE_CHIP_FLOW_TIMEOUT_SECONDS=15
FUGLE_CHIP_FLOW_MIN_REQUEST_INTERVAL_SECONDS=1.1
CHIP_FLOW_LARGE_ORDER_AMOUNT=2000000
CHIP_FLOW_SMALL_ORDER_AMOUNT=500000
CHIP_FLOW_DYNAMIC_LARGE_ORDER_ENABLED=true
CHIP_FLOW_DYNAMIC_LARGE_ORDER_PERCENTILE=0.99
CHIP_FLOW_DYNAMIC_LARGE_ORDER_MIN_SAMPLES=100
CHIP_FLOW_ALERT_WINDOW_MINUTES=5
CHIP_FLOW_ALERT_MIN_RECENT_NET_LOTS=10
CHIP_FLOW_ALERT_MIN_BUY_SELL_RATIO=1.5
CHIP_FLOW_ALERT_MIN_POSITIVE_STEPS=2
CHIP_FLOW_ALERT_MAX_STALE_MINUTES=10
CHIP_FLOW_ALERT_LIFECYCLE_MINUTES=15
CHIP_FLOW_ALERT_SUDDEN_DROP_RATIO=0.35
CHIP_FLOW_ALERT_MIN_MOMENTUM_CHANGE_LOTS=2
CHIP_FLOW_ALERT_MIN_SUDDEN_DROP_LOTS=5
CHIP_FLOW_ELECTRONIC_SCAN_INTERVAL_SECONDS=2
